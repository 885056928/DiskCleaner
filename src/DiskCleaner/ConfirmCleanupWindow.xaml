<Window x:Class="DiskCleaner.ConfirmCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认清理" Icon="Assets/DiskCleaner.ico" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" xml:lang="zh-CN"
        Background="{StaticResource Surface}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">
    <StackPanel Margin="22">
        <TextBlock Text="永久删除所选文件？" FontSize="21" FontWeight="SemiBold" />
        <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,10,0,4" />
        <TextBlock x:Name="FilePath" Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,6" />
        <TextBlock Text="文件将直接删除，无法从回收站恢复。" TextWrapping="Wrap"
                   Foreground="{StaticResource Muted}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" IsDefault="True"
                    Style="{StaticResource ActionButton}" MinWidth="78" Margin="0,0,8,0" />
            <Button Content="永久删除" Click="OnDelete" Style="{StaticResource DangerButton}" />
        </StackPanel>
    </StackPanel>
</Window>
